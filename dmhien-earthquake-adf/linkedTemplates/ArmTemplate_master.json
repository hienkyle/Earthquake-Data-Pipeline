{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "dmhien-earthquake-adf"
		},
		"EarthquakeAdls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'EarthquakeAdls'"
		},
		"EarthquakeAdls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dmhearthquakestorage.dfs.core.windows.net/"
		},
		"EarthquakeHttp_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://earthquake.usgs.gov/fdsnws/event/1/"
		},
		"EarthquakeAdls_properties_privateLinkResourceId": {
			"type": "string",
			"defaultValue": "/subscriptions/3530fd8f-4627-4b19-a808-e578e6378bc2/resourceGroups/hien-rg/providers/Microsoft.Storage/storageAccounts/dmhearthquakestorage"
		},
		"EarthquakeAdls_properties_groupId": {
			"type": "string",
			"defaultValue": "dfs"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "dmhien-earthquake-adf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"EarthquakeAdls_accountKey": {
						"value": "[parameters('EarthquakeAdls_accountKey')]"
					},
					"EarthquakeAdls_properties_privateLinkResourceId": {
						"value": "[parameters('EarthquakeAdls_properties_privateLinkResourceId')]"
					},
					"EarthquakeAdls_properties_groupId": {
						"value": "[parameters('EarthquakeAdls_properties_groupId')]"
					},
					"EarthquakeAdls_properties_typeProperties_url": {
						"value": "[parameters('EarthquakeAdls_properties_typeProperties_url')]"
					},
					"EarthquakeHttp_properties_typeProperties_url": {
						"value": "[parameters('EarthquakeHttp_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}